# ─── API Connection ───────────────────────────────────────────────────────────
# For cloud-connected deployments: set this to the cloud backend URL.
# When unset, the app uses window.location.origin (same-origin), which only
# works when the POS frontend is served by the backend itself on the same host.
# Example: VITE_API_BASE_URL=https://smartpos-backend-api.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:5102

VITE_POS_VERSION=1.0.0
VITE_INSTALLER_DOWNLOAD_URL=
VITE_INSTALLER_CHECKSUM_SHA256=
VITE_CLOUD_PORTAL_URL=
VITE_INVENTORY_MANAGER_URL=/inventory-manager
